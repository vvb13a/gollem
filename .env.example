# Copy to .env and adjust. The Makefile loads .env automatically.

# HTTP listen address for the API and embedded frontend.
APP_ADDR=:8080

# Display name and embedded frontend title.
APP_NAME=gollem

# SQLite database location. Leave empty to use the per-user OS data folder.
# `make dev` defaults this to ./.dev/data.
# APP_DATA_DIR=./.dev/data
